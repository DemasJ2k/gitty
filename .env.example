# Copy to .env and fill in. Only these are read by the server code.

# Postgres connection string (required). pgvector extension expected.
DATABASE_URL=postgresql://user:password@localhost:5432/trading_ai

# 64 hex chars. Generate with: openssl rand -hex 32
# Without this, the encryption key is derived from DATABASE_URL — set it
# explicitly before storing any real user API keys.
ENCRYPTION_KEY=

# Server port (default 5000)
PORT=5000

# Web push notifications (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# NOTE: Anthropic / OpenAI / Polygon / market-data keys are NOT set here.
# Users enter them in the app's Settings page; they are encrypted in the DB.

# --- Optional: only if you later enable the multi-vendor LLM Council ---
# Lets the council debate across GPT + Gemini + Claude via OpenRouter.
# Leave blank to run the council with Claude subagents only.
# OPENROUTER_API_KEY=
